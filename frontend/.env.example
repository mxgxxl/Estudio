# Frontend — variables de entorno (plantilla). Copia a .env y rellena los valores.
# Las REACT_APP_* se embeben en el BUILD (CRA/craco), no en runtime.
# NO pongas valores reales en este archivo de ejemplo.

# URL pública del backend (sin barra final). En local: http://127.0.0.1:8000
REACT_APP_BACKEND_URL=

# Pagos — Paddle (Billing v4)
# Client-side token de Paddle (Developer Tools > Authentication > Client-side tokens)
REACT_APP_PADDLE_CLIENT_TOKEN=
# Entorno de Paddle: sandbox | production
REACT_APP_PADDLE_ENV=sandbox
# ID del precio del plan Premium (empieza por pri_...)
REACT_APP_PADDLE_PREMIUM_PRICE_ID=
