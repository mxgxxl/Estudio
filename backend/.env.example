# Backend — variables de entorno (plantilla). Copia a .env y rellena los valores.
# NO pongas secretos reales en este archivo de ejemplo.

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=studia

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS (lista separada por comas, o * para permitir todo)
CORS_ORIGINS=*

# Auth / JWT
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio
# Caducidad del token de acceso en minutos (por defecto 7 días = 10080)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
