# Backend — variables de entorno (plantilla). Copia a .env y rellena los valores.
# NO pongas secretos reales en este archivo de ejemplo.

# MongoDB
# MONGO_URL apunta al cluster de Atlas. Es el MISMO cluster para local y
# producción; lo único que cambia entre entornos es DB_NAME (ver abajo).
MONGO_URL=mongodb+srv://usuario:password@tu-cluster.mongodb.net/?appName=Cluster0
# DB_NAME: cada entorno usa una BASE DE DATOS DISTINTA dentro del mismo cluster.
#   - Local (desarrollo):   studia_dev
#   - Producción (Railway): studia_staging
# NUNCA uses la misma base en local que en producción: en local trabajas contra
# studia_dev para no tocar los datos reales de producción.
DB_NAME=studia_dev

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS (lista separada por comas, o * para permitir todo)
CORS_ORIGINS=*

# Nivel de logging (DEBUG | INFO | WARNING | ERROR). Por defecto INFO.
# Súbelo a DEBUG para ver las trazas rutinarias (p. ej. las de Paddle).
LOG_LEVEL=INFO

# Auth / JWT
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio
# Caducidad del token de acceso en minutos (por defecto 7 días = 10080)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Límites de uso de IA (opcionales; valores por defecto 30 / 2000)
# FREE_AI_GENERATIONS_PER_MONTH=30
# PREMIUM_AI_GENERATIONS_PER_MONTH=2000

# Pagos — Paddle (Billing v4, NO Classic). En modo sandbox para pruebas.
PADDLE_ENV=sandbox
# Secret API key del backend (Paddle > Developer Tools > Authentication). Empieza por pdl_sdbx_apikey_...
PADDLE_API_KEY=PEGAR_AQUI
# Secret del conjunto de notificaciones del webhook (Paddle > Notifications). Empieza por pdl_ntfset_...
PADDLE_WEBHOOK_SECRET=PEGAR_AQUI
# ID del precio del plan Premium (Paddle > Catalog > Products > Prices). Empieza por pri_...
PADDLE_PREMIUM_PRICE_ID=PEGAR_AQUI
